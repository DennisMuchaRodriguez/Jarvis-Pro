# Copia este archivo como ".env" y rellena tus datos.

# --- Cerebro ---
# Consigue tu clave en https://platform.claude.com (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL=claude-opus-5-5
# Cuánto "piensa" antes de responder: low | medium | high. "low" = respuestas más rápidas (ideal para voz).
JARVIS_EFFORT=low
# Permite que Jarvis busque en internet para preguntas de actualidad (true/false)
JARVIS_WEB_SEARCH=true

# --- Personalidad ---
JARVIS_USER_NAME=Dennis
# Cómo te llama Jarvis
JARVIS_USER_TITLE=señor

# --- Voz y oído ---
# Idioma del reconocimiento de voz (es-MX, es-ES, es-CO, ...)
JARVIS_LANGUAGE=es-MX
# Motor de reconocimiento: google (gratis, online) | whisper (local, requiere faster-whisper)
JARVIS_STT_ENGINE=google
JARVIS_WHISPER_MODEL=small
# Voz de Jarvis. Otras: es-ES-AlvaroNeural, es-CO-GonzaloNeural, es-AR-TomasNeural
JARVIS_VOICE=es-MX-JorgeNeural
# Segundos que espera a que empieces a hablar
JARVIS_LISTEN_TIMEOUT=8
# Segundos de silencio que indican que terminaste tu orden. Súbelo (1.5–2) si te corta al hacer pausas.
JARVIS_SILENCE_END=1.2
# Duración máxima de una orden (segundos)
JARVIS_PHRASE_TIME_LIMIT=20
# Sensibilidad del detector de voz: 0 = capta voces lejanas/bajitas (y algo de ruido) ... 3 = solo voz clara
JARVIS_VAD_MODE=1
# Micrófono a usar: vacío = el predeterminado de Windows; o su número/nombre (lista con: python verificar.py)
JARVIS_MIC_DEVICE=
# Cuánto puede subir el volumen de tu voz antes de transcribirla (útil si hablas lejos)
JARVIS_MIC_MAX_GAIN=8
# Bip cuando Jarvis empieza a escucharte (true/false)
JARVIS_LISTEN_BEEP=true
# Rondas en silencio antes de volver a dormir
JARVIS_IDLE_ROUNDS=2

# --- Aplausos (calibra con: python -m jarvis.audio.clap_detector) ---
# Volumen mínimo (0 a 1) para considerar un sonido como aplauso
JARVIS_CLAP_THRESHOLD=0.30
# Tiempo mínimo y máximo (segundos) entre el primer y el segundo aplauso
JARVIS_CLAP_MIN_GAP=0.12
JARVIS_CLAP_MAX_GAP=0.80

# --- Programas ---
# Ruta del editor de Unity para abrir proyectos (puede sobreescribirse por proyecto en data/projects.json)
UNITY_EDITOR_PATH=C:\Program Files\Unity\Hub\Editor\2022.3.20f1\Editor\Unity.exe
# whatsapp: desktop (app instalada) | web (web.whatsapp.com en el navegador)
WHATSAPP_MODE=desktop
# Segundos que espera a que Discord termine de abrir si estaba cerrado
DISCORD_OPEN_WAIT=15
